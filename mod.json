{
	"geode": "5.7.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "rcg21.editor-hotbar",
	"name": "Editor Hotbar",
	"version": "v1.0.5",
	"developer": "RCG21",
	"description": "Add frequently used objects to a hotbar",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"tags": ["editor", "interface", "enhancement", "utility", "offline"],
	"links": {"source": "https://github.com/rhncg/editor-hotbar"},
	"settings": {
		"hotbar-color": {
			"type": "rgb",
			"name": "Hotbar Color",
			"default": "#555555"
		},
		"show-hotbar-outline": {
			"type": "bool",
			"name": "Show Hotbar Outline",
			"default": false
		},
		"hotbar-slot-1": {
			"type": "keybind",
			"name": "Hotbar Slot 1",
			"category": "editor",
			"default": ["Shift+One", "NumPad0"]
		},
		"hotbar-slot-2": {
			"type": "keybind",
			"name": "Hotbar Slot 2",
			"category": "editor",
			"default": ["Shift+Two", "NumPad1"]
		},
		"hotbar-slot-3": {
			"type": "keybind",
			"name": "Hotbar Slot 3",
			"category": "editor",
			"default": ["Shift+Three", "NumPad2"]
		},
		"hotbar-slot-4": {
			"type": "keybind",
			"name": "Hotbar Slot 4",
			"category": "editor",
			"default": ["Shift+Four", "NumPad3"]
		},
		"hotbar-slot-5": {
			"type": "keybind",
			"name": "Hotbar Slot 5",
			"category": "editor",
			"default": ["Shift+Five", "NumPad4"]
		},
		"hotbar-slot-6": {
			"type": "keybind",
			"name": "Hotbar Slot 6",
			"category": "editor",
			"default": ["Shift+Six", "NumPad5"]
		},
		"hotbar-slot-7": {
			"type": "keybind",
			"name": "Hotbar Slot 7",
			"category": "editor",
			"default": ["Shift+Seven", "NumPad6"]
		},
		"hotbar-slot-8": {
			"type": "keybind",
			"name": "Hotbar Slot 8",
			"category": "editor",
			"default": ["Shift+Eight", "NumPad7"]
		},
		"hotbar-slot-9": {
			"type": "keybind",
			"name": "Hotbar Slot 9",
			"category": "editor",
			"default": ["Shift+Nine", "NumPad8"]
		},
		"hotbar-slot-10": {
			"type": "keybind",
			"name": "Hotbar Slot 10",
			"category": "editor",
			"default": ["Shift+Zero", "NumPad9"]
		}
	}
}
